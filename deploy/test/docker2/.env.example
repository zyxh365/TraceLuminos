# ═══════════════════════════════════════════════════════════════
# TSP 可观测性平台 — 共享环境变量
# 部署前复制为 .env 并修改实际值
# 此文件同时在 Server A 和 Server B 上使用
# ═══════════════════════════════════════════════════════════════

# ── 业务公共参数 ──
BUSINESS=tsp
DEPLOY_ENV=test
REGION=cn-east-4

# ── Kafka（华为云 DMS，PLAINTEXT 无认证） ──
KAFKA_BOOTSTRAP_SERVERS=172.26.17.53:9092,172.26.17.9:9092,172.26.17.54:9092

# ── ClickHouse（每台服务器单独覆盖） ──
# Server A: CLICKHOUSE_HOST=<SERVER_B_IP>
# Server B: CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=tsp123456
CLICKHOUSE_DATABASE=platform
