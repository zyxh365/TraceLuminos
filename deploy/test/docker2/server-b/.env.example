# ═══════════════════════════════════════════════════════════════
# TSP 可观测性平台 — Server B 环境变量
# 部署前复制为 .env 并修改实际值
# ═══════════════════════════════════════════════════════════════

# ── ClickHouse（本机 Docker，容器名 clickhouse） ──
CLICKHOUSE_HOST=clickhouse
# 其他 ClickHouse 参数在共享 ../.env 中:
# CLICKHOUSE_NATIVE_PORT=9000
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=tsp123456
# CLICKHOUSE_DATABASE=platform

# ── VictoriaMetrics（本机 Docker） ──
VM_ENDPOINT=victoriametrics
