# ═══════════════════════════════════════════════════════════════
# TSP 可观测性平台 — Docker 部署环境变量
# 版本：v5.0
# 使用方式：cp .env.example .env → 修改实际值
# ═══════════════════════════════════════════════════════════════

# ── 业务公共参数 ──────────────────────────────
BUSINESS=tsp
DEPLOY_ENV=test
REGION=cn-east

# ── 服务器 IP ─────────────────────────────────
SERVER_A_IP=172.26.17.121
SERVER_B_IP=172.26.17.91

# ── 华为云 DMS Kafka（无认证 / PLAINTEXT）─────
KAFKA_BOOTSTRAP_SERVERS=172.26.17.53:9092,172.26.17.9:9092,172.26.17.54:9092

# ── 华为云 CloudTable ClickHouse ──────────────
CLICKHOUSE_HOST=clickhouse-xxx.cloudtable.huaweicloud.com
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=otel
